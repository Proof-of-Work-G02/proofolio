{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofolio.dev/contracts/schemas/events/processing.completed.schema.json",
  "title": "ProcessingCompleted",
  "description": "Queue `processing-results`. Producer: CV / GitHub / LinkedIn services. Consumer: Core Backend (Job Orchestrator). SQS Event Contracts §5.1.",
  "x-queue": "processing-results",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "../common/fields.schema.json#/$defs/schemaVersion"
    },
    "eventId": {
      "$ref": "../common/fields.schema.json#/$defs/eventId"
    },
    "occurredAt": {
      "$ref": "../common/fields.schema.json#/$defs/occurredAt"
    },
    "jobId": {
      "$ref": "../common/fields.schema.json#/$defs/id"
    },
    "event": {
      "type": "string",
      "const": "processing.completed"
    },
    "taskId": {
      "$ref": "../common/fields.schema.json#/$defs/id"
    },
    "sourceType": {
      "$ref": "../common/source-type.schema.json"
    },
    "status": {
      "type": "string",
      "const": "COMPLETED"
    },
    "resultS3Key": {
      "$ref": "../common/fields.schema.json#/$defs/s3Key"
    },
    "attempt": {
      "$ref": "../common/fields.schema.json#/$defs/attempt"
    }
  },
  "required": [
    "schemaVersion",
    "eventId",
    "event",
    "occurredAt",
    "jobId",
    "taskId",
    "sourceType",
    "status",
    "resultS3Key"
  ],
  "additionalProperties": false
}
