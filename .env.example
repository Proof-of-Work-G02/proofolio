# Proofolio environment variables.
#
# Copy to .env and fill in the blanks: `cp .env.example .env`.
# `python scripts/dev.py` uses .env when it exists, otherwise this file.
# Never commit .env or any real secret. The values below are local-only defaults.
#
# Hosts: these values are for code running on your machine (localhost).
# Containers inside Compose reach the same things as postgres:5432,
# elasticmq:9324 and s3:9000; docker-compose.yml overrides the hosts for them.

# --- Environment -------------------------------------------------------------
# local | dev | prod
APP_ENV=local
LOG_LEVEL=INFO
AWS_REGION=eu-central-1

# --- PostgreSQL (one database, separate schemas for Core and Website Service) ---
POSTGRES_DB=proofolio
POSTGRES_USER=proofolio
POSTGRES_PASSWORD=proofolio
POSTGRES_PORT=5432
DATABASE_URL=postgresql://proofolio:proofolio@localhost:5432/proofolio

# --- SQS (ElasticMQ locally) --------------------------------------------------
# ElasticMQ accepts any credentials; on AWS these come from the task role instead.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_ENDPOINT_URL_SQS=http://localhost:9324
SQS_PORT=9324
SQS_QUEUE_URL_CV_EXTRACTION=http://localhost:9324/000000000000/cv-extraction
SQS_QUEUE_URL_GITHUB_ANALYSIS=http://localhost:9324/000000000000/github-analysis
SQS_QUEUE_URL_LINKEDIN_EXTRACTION=http://localhost:9324/000000000000/linkedin-extraction
SQS_QUEUE_URL_WEBSITE_GENERATION=http://localhost:9324/000000000000/website-generation
SQS_QUEUE_URL_WEBSITE_PUBLISHING=http://localhost:9324/000000000000/website-publishing
SQS_QUEUE_URL_PROCESSING_RESULTS=http://localhost:9324/000000000000/processing-results
# Dead-letter queues, read by the Core Backend DLQ listener.
SQS_DLQ_URL_CV_EXTRACTION=http://localhost:9324/000000000000/cv-extraction-dlq
SQS_DLQ_URL_GITHUB_ANALYSIS=http://localhost:9324/000000000000/github-analysis-dlq
SQS_DLQ_URL_LINKEDIN_EXTRACTION=http://localhost:9324/000000000000/linkedin-extraction-dlq
SQS_DLQ_URL_WEBSITE_GENERATION=http://localhost:9324/000000000000/website-generation-dlq
SQS_DLQ_URL_WEBSITE_PUBLISHING=http://localhost:9324/000000000000/website-publishing-dlq
SQS_DLQ_URL_PROCESSING_RESULTS=http://localhost:9324/000000000000/processing-results-dlq

# --- S3 (RustFS locally) ------------------------------------------------------
AWS_ENDPOINT_URL_S3=http://localhost:9000
S3_PORT=9000
S3_CONSOLE_PORT=9001
# RustFS admin user; also the S3 credentials services use locally.
S3_ACCESS_KEY_ID=proofolio
S3_SECRET_ACCESS_KEY=proofolio-secret
S3_BUCKET_UPLOADS=portfolio-uploads
S3_BUCKET_EXTRACTION_RESULTS=extraction-results
S3_BUCKET_PUBLISHED_WEBSITES=published-websites

# --- Internal service URLs ---------------------------------------------------
CORE_BACKEND_URL=http://localhost:8000
WEBSITE_SERVICE_URL=http://localhost:8001
RENDER_WORKER_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173

# --- AI / LLM ----------------------------------------------------------------
# anthropic = real Claude API (needs ANTHROPIC_API_KEY); fake = canned responses, no key, no cost.
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
LLM_MODEL_EXTRACTION=claude-haiku-5-5
LLM_MODEL_GENERATION=claude-sonnet-5-5

# --- GitHub analysis -----------------------------------------------------------
# Server-side, read-only token for public GitHub data. Never sent in events.
GITHUB_TOKEN=

# --- Authentication ------------------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
# Long random strings. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=change-me-local-only
# Shared secret for HMAC-signed internal calls (Core <-> Website Service, Publisher -> render worker). See contracts/hmac.
INTERNAL_SERVICE_SECRET=change-me-local-only

# --- Published sites -------------------------------------------------------------
# Sites are served at https://<slug>.<PUBLIC_SITE_DOMAIN>.
PUBLIC_SITE_DOMAIN=localhost
