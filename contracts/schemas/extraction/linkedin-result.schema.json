{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proofolio.dev/contracts/schemas/extraction/linkedin-result.schema.json",
  "title": "LinkedInExtractionResult",
  "description": "Output of the LinkedIn Extraction Service, key <jobId>/<taskId>/linkedin.json. Stored in the extraction-results bucket. Shared Data Contracts §3, §6.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "$ref": "../common/fields.schema.json#/$defs/schemaVersion"
    },
    "jobId": {
      "$ref": "../common/fields.schema.json#/$defs/id"
    },
    "taskId": {
      "$ref": "../common/fields.schema.json#/$defs/id"
    },
    "sourceType": {
      "type": "string",
      "const": "LINKEDIN"
    },
    "profile": {
      "$ref": "../profile/professional-profile.schema.json"
    }
  },
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "jobId",
    "taskId",
    "sourceType",
    "profile"
  ]
}
